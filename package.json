{
  "name": "github-admin-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A private MCP server for administering GitHub repositories using a Personal Access Token (PAT).",
  "main": "dist/mcp/index.js",
  "types": "dist/mcp/index.d.ts",
  "scripts": {
    "build": "tsup src/mcp/index.ts --format cjs,esm --dts --out-dir dist",
    "dev": "ts-node src/mcp/index.ts",
    "test": "vitest",
    "lint": "eslint 'src/**/*.ts'"
    ,
    "setup": "ts-node ./scripts/setup.ts",
    "doctor": "node ./scripts/doctor.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["github", "mcp", "cli", "admin"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.6",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "tsup": "^7.0.0",
    "typescript": "^5.2.2",
    "vitest": "^0.34.1"
  }
}